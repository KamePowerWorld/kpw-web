---
import "../styles/global.css";
import { logoDataUrl } from "../lib/brand-assets";

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
}

const { title, description, bodyClass = "" } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={logoDataUrl} />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
