---
export const prerender = false;

import EditorApp from "../components/EditorApp";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadNavigation, loadPages } from "../lib/content";

const docs = loadPages({ includeDrafts: true }).map(({ id, slug, filePath, body, data, canonicalPath, parentId, childIds, depth }) => ({ id, slug, filePath, body, data, canonicalPath, parentId, childIds, depth }));
const navigation = loadNavigation();
---

<BaseLayout title="ガイドエディター | かめぱわぁ〜るど" description="Discordの権限とつながるWYSIWYG Markdownエディター" bodyClass="editor-page" noIndex>
  <EditorApp client:only="react" initialDocs={docs} initialNavigation={navigation} />
</BaseLayout>
