---
export const prerender = false;

import GuidePage from "../components/GuidePage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadPages, resolvePagePath } from "../lib/content";

const pages = loadPages();
const page = resolvePagePath("/");
if (!page) throw new Error("pages/index/index.md is required.");
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "かめぱわぁ〜るど みんなのガイド",
  url: new URL("/", siteUrl).href,
  description: page.data.heroLead,
  inLanguage: "ja",
};
---

<BaseLayout title={page.data.title} description={page.data.heroLead} canonicalPath="/" structuredData={structuredData}>
  <GuidePage page={page} pages={pages} />
</BaseLayout>
