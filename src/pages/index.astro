---
export const prerender = false;

import GuidePage from "../components/GuidePage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadPages, resolvePagePath } from "../lib/content";

const pages = loadPages();
const page = resolvePagePath("/");
if (!page) throw new Error("pages/index/index.md is required.");
---

<BaseLayout title={page.data.title} description={page.data.heroLead} canonicalPath="/">
  <GuidePage page={page} pages={pages} />
</BaseLayout>
