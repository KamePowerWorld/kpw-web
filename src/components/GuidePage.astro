---
import type { DocPage } from "../lib/content";
import { mascotDataUrl } from "../lib/brand-assets";

interface Props { page: DocPage; pages: DocPage[]; }
const { page, pages } = Astro.props;
const byId = new Map(pages.map((item) => [item.id, item]));
const firstHeading = page.headings[0]?.id ?? "content";
const hasHeroImage = Boolean(page.heroImageUrl);
const children = page.childIds.map((id) => byId.get(id)).filter((item): item is DocPage => Boolean(item));
const breadcrumbs: DocPage[] = [];
let parentId = page.parentId;
while (parentId) {
  const parent = byId.get(parentId);
  if (!parent) break;
  breadcrumbs.unshift(parent);
  parentId = parent.parentId;
}
const treePages = pages.filter((item) => item.slug !== "index");
const expandedPageIds = new Set([...breadcrumbs.map((item) => item.id), page.id]);
const visibleTreePages = treePages.filter((item) => !item.parentId || expandedPageIds.has(item.parentId));
---

<main>
  <div class="top-strip" aria-hidden="true"></div>
  <header class="site-header">
    <a class="brand" href="/" aria-label="かめぱわぁ〜るど ガイド トップ">
      <img src="/generated/v1/brand-logo-96.webp" srcset="/generated/v1/brand-logo-64.webp 64w, /generated/v1/brand-logo-96.webp 96w, /generated/v1/brand-logo-128.webp 128w, /generated/v1/brand-logo-192.webp 192w" sizes="(max-width: 800px) 48px, 58px" width="192" height="192" alt="かめぱわぁ〜るど" /><span>みんなのガイド</span>
    </a>
    <nav class="header-links" aria-label="サイト内リンク">
      <a class="desktop-nav-link" href="#page-navigation">ページ一覧</a>
      <a class="mobile-nav-link" href="#mobile-page-navigation">ページ一覧</a>
      <a class="edit-link" href={`/editor?page=${encodeURIComponent(page.id)}`}>編集</a>
    </nav>
  </header>

  <div class:list={["hero-region", { "hero-region-with-image": hasHeroImage }]}>
    <details class="mobile-page-tree" id="mobile-page-navigation">
      <summary>ページを探す</summary>
      <nav>
        <a class:list={["tree-link", { active: page.slug === "index" }]} href="/">トップ</a>
        {visibleTreePages.map((item) => <a class:list={["tree-link", { active: item.id === page.id, "has-children": item.childIds.length > 0 }]} aria-current={item.id === page.id ? "page" : undefined} style={`--depth:${item.depth}`} href={item.canonicalPath}>{item.data.title}</a>)}
      </nav>
    </details>

    <nav class="breadcrumbs" aria-label="パンくず">
      <a href="/">トップ</a>
      {breadcrumbs.map((item) => <><span>›</span><a href={item.canonicalPath}>{item.data.title}</a></>)}
      {page.slug !== "index" && <><span>›</span><strong>{page.data.title}</strong></>}
    </nav>

    <section class:list={["hero", { "hero-with-image": hasHeroImage }]}>
      <div class="confetti c1">●</div><div class="confetti c2">◆</div><div class="confetti c3">▲</div><div class="confetti c4">●</div>
      <div class="hero-copy">
        <h1>{page.data.title}</h1><p class="lead">{page.data.heroLead}</p>
        <a class="hero-button" href={`#${firstHeading}`}>ガイドを見てみる <span>→</span></a>
      </div>
      <div class:list={["hero-art", { "hero-art-with-image": hasHeroImage }]}>
        <div class="speech">いっしょに遊ぼ！</div>
        <img
          src={page.heroImageUrl ?? mascotDataUrl}
          srcset={page.heroImage?.srcset}
          sizes={page.heroImage ? "(max-width: 720px) calc(100vw - 48px), 610px" : undefined}
          width={page.heroImage?.width}
          height={page.heroImage?.height}
          loading={page.heroImage ? "eager" : undefined}
          decoding={page.heroImage ? "async" : undefined}
          fetchpriority={page.heroImage ? "high" : undefined}
          alt={page.heroImageUrl ? page.data.title : "かめっち"}
        />
      </div>
    </section>
  </div>

  <div class="ticker" aria-label={page.data.title}><div>★ KAMEPOWER WORLD ★ {page.data.title} ★ PLAY ・ CREATE ・ ENJOY ★</div></div>
  <div class="page-shell">
    <aside class="sidebar" id="page-navigation">
      <p>PAGES</p>
      <nav class="page-tree">
        <a class:list={["tree-link", { active: page.slug === "index" }]} href="/">トップ</a>
        {visibleTreePages.map((item) => <a class:list={["tree-link", { active: item.id === page.id, "has-children": item.childIds.length > 0 }]} aria-current={item.id === page.id ? "page" : undefined} style={`--depth:${item.depth}`} href={item.canonicalPath}>{item.data.title}</a>)}
      </nav>
      {page.headings.length > 0 && <><p class="heading-label">CONTENTS</p><nav class="heading-tree">
        {page.headings.map((heading, index) => <a class:list={{ active: index === 0 }} href={`#${heading.id}`} data-heading-id={heading.id}><span>{String(index + 1).padStart(2, "0")}</span>{heading.text}</a>)}
      </nav></>}
    </aside>
    <div class="article-column">
      <article class="markdown-body notion-article" set:html={page.html}></article>
      {children.length > 0 && <section class="child-pages" aria-labelledby="child-pages-title">
        <h2 id="child-pages-title">子ページ</h2>
        <div>{children.map((child) => <a href={child.canonicalPath}><strong>{child.data.title}</strong><span>{child.data.heroLead}</span><b>→</b></a>)}</div>
      </section>}
    </div>
  </div>
  <footer><img src="/generated/v1/brand-logo-96.webp" srcset="/generated/v1/brand-logo-64.webp 64w, /generated/v1/brand-logo-96.webp 96w, /generated/v1/brand-logo-128.webp 128w, /generated/v1/brand-logo-192.webp 192w" sizes="48px" width="192" height="192" alt="" loading="lazy" decoding="async" /><div><b>かめぱわぁ〜るど</b><span>みんなでつくる、ちょっと変な遊び場。</span></div></footer>
</main>

<script>
  const headingLinks = [...document.querySelectorAll<HTMLAnchorElement>(".heading-tree [data-heading-id]")];
  const headingElements = headingLinks.map((link) => document.getElementById(link.dataset.headingId ?? "")).filter((heading): heading is HTMLElement => Boolean(heading));
  const activateHeading = (active: HTMLElement) => {
    headingLinks.forEach((link) => link.classList.toggle("active", link.dataset.headingId === active?.id));
  };
  headingLinks.forEach((link, index) => link.addEventListener("click", () => {
    const heading = headingElements[index];
    if (heading) activateHeading(heading);
  }));
  if ("IntersectionObserver" in window) {
    const visibleHeadings = new Set<HTMLElement>();
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const heading = entry.target as HTMLElement;
        if (entry.isIntersecting) visibleHeadings.add(heading);
        else visibleHeadings.delete(heading);
      });
      const active = headingElements.findLast((heading) => visibleHeadings.has(heading));
      if (active) activateHeading(active);
    }, { rootMargin: "0px 0px -70% 0px" });
    headingElements.forEach((heading) => observer.observe(heading));
  }

  const mobilePageLink = document.querySelector<HTMLAnchorElement>(".mobile-nav-link");
  const mobilePageTree = document.querySelector<HTMLDetailsElement>("#mobile-page-navigation");
  mobilePageLink?.addEventListener("click", (event) => {
    if (!mobilePageTree || getComputedStyle(mobilePageLink).display === "none") return;
    event.preventDefault();
    mobilePageTree.open = true;
    mobilePageTree.classList.remove("is-highlighted");
    void mobilePageTree.offsetWidth;
    mobilePageTree.classList.add("is-highlighted");
    history.replaceState(null, "", "#mobile-page-navigation");
    mobilePageTree.scrollIntoView({ behavior: "smooth", block: "start" });
  });
  mobilePageTree?.addEventListener("animationend", () => mobilePageTree.classList.remove("is-highlighted"));

  const desktopPageLink = document.querySelector<HTMLAnchorElement>(".desktop-nav-link");
  const desktopPageTree = document.querySelector<HTMLElement>("#page-navigation");
  desktopPageLink?.addEventListener("click", (event) => {
    if (!desktopPageTree || getComputedStyle(desktopPageLink).display === "none") return;
    event.preventDefault();
    desktopPageTree.classList.remove("is-highlighted");
    void desktopPageTree.offsetWidth;
    desktopPageTree.classList.add("is-highlighted");
    history.replaceState(null, "", "#page-navigation");
    desktopPageTree.scrollIntoView({ behavior: "smooth", block: "start" });
  });
  desktopPageTree?.addEventListener("animationend", (event) => {
    if (event.target === desktopPageTree) desktopPageTree.classList.remove("is-highlighted");
  });
</script>
