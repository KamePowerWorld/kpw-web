{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kpw-web",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "workers_dev": true,
  "preview_urls": true,
  "secrets": {
    "required": ["DISCORD_CLIENT_SECRET", "DISCORD_BOT_TOKEN", "GITHUB_APP_PRIVATE_KEY"]
  },
  "routes": [
    {
      "pattern": "docs.kamesuta.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "650f85c2853c433b91089cf8d1710a6b"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "kpw-web-auth",
      "database_id": "47776198-8221-4ae1-a533-99fcc316abc0",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GITHUB_OWNER": "KamePowerWorld",
    "GITHUB_REPO": "kpw-docs",
    "GITHUB_BRANCH": "master",
    "GITHUB_APP_SLUG": "kamepowerworldeditor"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
