{
  "name": "@kamepowerworld/kpw-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "predev": "npm run sync:docs",
    "dev": "astro dev --host 0.0.0.0",
    "prebuild": "npm run sync:docs",
    "build": "astro build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json --keep-vars",
    "check": "npm run sync:docs && astro check",
    "test": "npm run check && npm run build && node --test tests/*.test.mjs && node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.0",
    "@astrojs/react": "6.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@milkdown/crepe": "7.22.0",
    "@milkdown/kit": "7.22.0",
    "@milkdown/react": "7.22.0",
    "astro": "7.2.0",
    "diff": "^9.0.0",
    "dompurify": "3.4.13",
    "lucide-react": "^1.31.0",
    "marked": "17.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.6",
    "sharp": "0.35.3",
    "sweetalert2": "^11.26.25",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@playwright/test": "^1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.0",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "wrangler": "^4.123.0"
  }
}
